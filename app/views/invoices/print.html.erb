<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= @invoice.doc_type.capitalize %> — <%= @invoice.invoice_number %></title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      margin: 0;
      padding: 40px;
      color: #1e293b;
      background: #fff;
    }
    .invoice-container {
      max-width: 800px;
      margin: 0 auto;
    }
    .header {
      display: flex;
      justify-content: space-between;
      border-bottom: 2px solid #e2e8f0;
      padding-bottom: 24px;
      margin-bottom: 24px;
    }
    .brand-title {
      font-size: 24px;
      font-weight: 800;
      color: #0f172a;
      margin: 0 0 6px;
    }
    .doc-badge {
      display: inline-block;
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 4px 12px;
      border-radius: 4px;
      background: #f1f5f9;
      color: #475569;
      margin-bottom: 8px;
    }
    .doc-num {
      font-size: 20px;
      font-weight: 800;
      color: #0f172a;
      margin: 0;
    }
    .meta-grid {
      display: flex;
      justify-content: space-between;
      margin-bottom: 30px;
      gap: 30px;
    }
    .meta-col {
      flex: 1;
    }
    .meta-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      color: #64748b;
      margin-bottom: 6px;
    }
    .meta-name {
      font-size: 16px;
      font-weight: 700;
      color: #0f172a;
      margin: 0 0 4px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 30px;
    }
    th {
      background: #f8fafc;
      border-bottom: 2px solid #e2e8f0;
      padding: 10px 14px;
      text-align: left;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      color: #475569;
    }
    td {
      padding: 12px 14px;
      border-bottom: 1px solid #e2e8f0;
      font-size: 14px;
    }
    .text-right {
      text-align: right;
    }
    .totals-area {
      display: flex;
      justify-content: space-between;
      gap: 30px;
    }
    .terms-box {
      flex: 1;
      font-size: 12px;
      color: #64748b;
      background: #f8fafc;
      padding: 16px;
      border-radius: 6px;
    }
    .totals-table {
      width: 280px;
      font-size: 14px;
    }
    .totals-row {
      display: flex;
      justify-content: space-between;
      padding: 6px 0;
    }
    .grand-total {
      font-size: 18px;
      font-weight: 800;
      border-top: 2px solid #0f172a;
      padding-top: 10px;
      margin-top: 6px;
      color: #0f172a;
    }
    .paid-stamp {
      display: inline-block;
      padding: 6px 14px;
      border: 2px solid #10b981;
      color: #10b981;
      font-weight: 800;
      border-radius: 6px;
      text-transform: uppercase;
      margin-top: 10px;
    }
    .no-print-bar {
      background: #0f172a;
      color: #fff;
      padding: 12px 24px;
      position: sticky;
      top: 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: -40px -40px 30px -40px;
    }
    @media print {
      .no-print-bar { display: none !important; }
      body { padding: 0 !important; }
    }
  </style>
</head>
<body>
  <div class="no-print-bar">
    <div>Print Preview — <%= @invoice.invoice_number %></div>
    <div>
      <button onclick="window.print();" style="background: #4f46e5; color: #fff; border: none; padding: 8px 16px; border-radius: 4px; font-weight: 700; cursor: pointer;">
        🖨️ Print / Save as PDF
      </button>
    </div>
  </div>

  <div class="invoice-container">
    <div class="header">
      <div>
        <h1 class="brand-title"><%= current_business.name %></h1>
        <div style="font-size: 13px; color: #64748b; line-height: 1.4;">
          <%= current_business.address %><br>
          Phone: <%= current_business.phone %> • Email: <%= current_business.email %>
          <% if current_business.tax_id.present? %>
            <br>GSTIN / Tax ID: <strong><%= current_business.tax_id %></strong>
          <% end %>
        </div>
      </div>
      <div style="text-align: right;">
        <span class="doc-badge"><%= @invoice.doc_type == "quotation" ? "Quotation / Estimate" : "Tax Invoice" %></span>
        <div class="doc-num"><%= @invoice.invoice_number %></div>
        <div style="font-size: 13px; color: #64748b; margin-top: 6px;">
          Date: <strong><%= @invoice.issue_date.strftime("%d %b %Y") %></strong><br>
          <% if @invoice.due_date %>
            Due: <strong><%= @invoice.due_date.strftime("%d %b %Y") %></strong>
          <% end %>
        </div>
      </div>
    </div>

    <div class="meta-grid">
      <div class="meta-col">
        <div class="meta-label">Billed To</div>
        <div class="meta-name"><%= @invoice.client&.name || "Customer" %></div>
        <div style="font-size: 13px; color: #475569; line-height: 1.4;">
          <% if @invoice.client&.company_name.present? %>
            <strong><%= @invoice.client.company_name %></strong><br>
          <% end %>
          <%= @invoice.client&.address %><br>
          Phone: <%= @invoice.client&.phone %>
          <% if @invoice.client&.tax_id.present? %>
            <br>GSTIN / Tax ID: <%= @invoice.client.tax_id %>
          <% end %>
        </div>
      </div>
      <% if @invoice.work_project %>
        <div class="meta-col" style="text-align: right;">
          <div class="meta-label">Project / Site</div>
          <div class="meta-name"><%= @invoice.work_project.title %></div>
        </div>
      <% end %>
    </div>

    <table>
      <thead>
        <tr>
          <th style="width: 40px;">#</th>
          <th>Description</th>
          <th class="text-right" style="width: 80px;">Qty</th>
          <th class="text-right" style="width: 120px;">Unit Price</th>
          <th class="text-right" style="width: 120px;">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% @items.each_with_index do |item, idx| %>
          <tr>
            <td style="color: #94a3b8;"><%= idx + 1 %></td>
            <td><strong><%= item.description %></strong></td>
            <td class="text-right"><%= item.quantity %></td>
            <td class="text-right"><%= current_business.formatted_currency(item.unit_price) %></td>
            <td class="text-right"><strong><%= current_business.formatted_currency(item.total_price) %></strong></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="totals-area">
      <div class="terms-box">
        <% if @invoice.terms.present? %>
          <strong style="color: #0f172a;">Terms & Payment Instructions:</strong><br>
          <%= simple_format(@invoice.terms) %>
        <% else %>
          <strong style="color: #0f172a;">Thank you for your business!</strong>
        <% end %>
      </div>

      <div class="totals-table">
        <div class="totals-row">
          <span>Subtotal:</span>
          <span><%= current_business.formatted_currency(@invoice.subtotal) %></span>
        </div>
        <% if @invoice.discount_amount.to_f > 0 %>
          <div class="totals-row" style="color: #ef4444;">
            <span>Discount:</span>
            <span>-<%= current_business.formatted_currency(@invoice.discount_amount) %></span>
          </div>
        <% end %>
        <% if @invoice.tax_rate.to_f > 0 %>
          <div class="totals-row">
            <span>Tax (<%= @invoice.tax_rate %>%):</span>
            <span><%= current_business.formatted_currency(@invoice.tax_amount) %></span>
          </div>
        <% end %>
        <div class="totals-row grand-total">
          <span>Total:</span>
          <span><%= current_business.formatted_currency(@invoice.total_amount) %></span>
        </div>

        <% if @invoice.invoice? %>
          <div class="totals-row" style="color: #10b981; margin-top: 8px;">
            <span>Paid Amount:</span>
            <span><%= current_business.formatted_currency(@invoice.paid_amount) %></span>
          </div>
          <div class="totals-row" style="font-weight: 700; color: #f59e0b; border-top: 1px dashed #cbd5e1; padding-top: 8px; margin-top: 4px;">
            <span>Balance Due:</span>
            <span><%= current_business.formatted_currency(@invoice.balance_amount) %></span>
          </div>
          <% if @invoice.balance_amount <= 0 %>
            <div style="text-align: right;">
              <span class="paid-stamp">✓ PAID IN FULL</span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</body>
</html>
