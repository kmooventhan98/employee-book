<% content_for :page_title do %>
  <span>Daily Attendance Register</span>
<% end %>

<!-- Top Header with Date Navigation & View Switcher -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h2 style="font-size: 1.4rem; font-weight: 800; color: #fff; display: flex; align-items: center; gap: 0.5rem;">
      <span>📝 Attendance Register</span>
      <span style="font-size: 0.85rem; color: var(--text-muted); font-weight: 500;">
        <%= employee? ? "My Attendance Check-in" : "#{current_business.name}" %>
      </span>
    </h2>
    <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 0.15rem;">
      <%= employee? ? "Tap your status below to mark your shift for today" : "1-Touch tile register: Tap tabs or worker icon to cycle attendance" %>
    </p>
  </div>

  <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
    <!-- View Switcher -->
    <div class="att-view-tabs">
      <button type="button" onclick="switchAttMode('tiles')" id="tab-btn-tiles" class="att-view-tab <%= 'active' if @current_mode != 'table' %>">
        <span>📱</span> 1-Touch Tiles
      </button>
      <button type="button" onclick="switchAttMode('table')" id="tab-btn-table" class="att-view-tab <%= 'active' if @current_mode == 'table' %>">
        <span>📋</span> Table Mode
      </button>
      <%= link_to calendar_attendances_path(month: @selected_date.beginning_of_month), class: "att-view-tab" do %>
        <span>📅</span> Calendar View
      <% end %>
    </div>

    <!-- Date Navigator -->
    <%= form_with url: bulk_attendances_path, method: :get, local: true, style: "display: flex; align-items: center; gap: 0.35rem;" do |df| %>
      <%= hidden_field_tag :mode, @current_mode, id: "date-nav-mode" %>
      <%= link_to "←", bulk_attendances_path(date: @selected_date - 1.day, mode: @current_mode), class: "btn btn-secondary btn-sm", title: "Yesterday" %>
      <%= df.date_field :date, value: @selected_date, onchange: "this.form.submit();", class: "form-control", style: "width: auto; padding: 0.4rem 0.6rem; font-size: 0.88rem;" %>
      <%= link_to "→", bulk_attendances_path(date: @selected_date + 1.day, mode: @current_mode), class: "btn btn-secondary btn-sm", title: "Tomorrow" %>
      <% unless @selected_date == Date.current %>
        <%= link_to "Today", bulk_attendances_path(date: Date.current, mode: @current_mode), class: "btn btn-primary btn-sm" %>
      <% end %>
    <% end %>
  </div>
</div>

<!-- Daily Summary Metrics -->
<div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); margin-bottom: 1.25rem;">
  <div class="stat-card success" style="padding: 0.85rem 1rem;">
    <div class="stat-meta">
      <div class="stat-label">Present</div>
      <div class="stat-value" id="summary-present-count" style="color: var(--success-text); font-size: 1.35rem;"><%= @present_count %> / <%= @total_laborers %></div>
    </div>
  </div>

  <div class="stat-card warning" style="padding: 0.85rem 1rem;">
    <div class="stat-meta">
      <div class="stat-label">Half Day</div>
      <div class="stat-value" id="summary-half-count" style="color: var(--warning-text); font-size: 1.35rem;"><%= @half_count %></div>
    </div>
  </div>

  <div class="stat-card danger" style="padding: 0.85rem 1rem;">
    <div class="stat-meta">
      <div class="stat-label">Absent (Default)</div>
      <div class="stat-value" id="summary-absent-count" style="color: var(--danger-text); font-size: 1.35rem;"><%= @absent_count %></div>
    </div>
  </div>

  <% if admin? %>
    <div class="stat-card primary" style="padding: 0.85rem 1rem;">
      <div class="stat-meta">
        <div class="stat-label">Day's Labor Wage</div>
        <div class="stat-value" style="font-size: 1.35rem;"><%= current_business.formatted_currency(@total_day_wage) %></div>
      </div>
    </div>
  <% end %>
</div>

<% if @employees.empty? %>
  <div class="card" style="text-align: center; padding: 3rem 1rem;">
    <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">👷</div>
    <h3 style="color: #fff; margin-bottom: 0.5rem;">No active employees found</h3>
    <p style="color: var(--text-muted); margin-bottom: 1rem;">Add your laborers to start marking their daily attendance and wages.</p>
    <% if admin? %>
      <%= link_to "+ Add Employee", new_employee_path, class: "btn btn-primary" %>
    <% end %>
  </div>
<% else %>
  <%= form_with url: bulk_update_attendances_path, method: :post, local: true, id: "attendance-form" do |f| %>
    <%= hidden_field_tag :date, @selected_date %>

    <!-- Action Bar: Fast Bulk Selection (Admin Only) -->
    <% if admin? %>
      <div class="card" style="padding: 0.75rem 1rem; margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
        <div style="font-size: 0.88rem; color: #cbd5e1; font-weight: 600;">
          📅 <%= @selected_date.strftime("%A, %d %B %Y") %>
        </div>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
          <button type="button" onclick="setAllWorkers('present')" class="btn btn-secondary btn-sm" style="border-color: rgba(16, 185, 129, 0.4); color: var(--success-text);">
            ✓ Mark All Present
          </button>
          <button type="button" onclick="setAllWorkers('half_day')" class="btn btn-secondary btn-sm" style="border-color: rgba(245, 158, 11, 0.4); color: var(--warning-text);">
            ½ Mark All Half Day
          </button>
          <button type="button" onclick="setAllWorkers('absent')" class="btn btn-secondary btn-sm" style="border-color: rgba(239, 68, 68, 0.4); color: var(--danger-text);">
            ✗ Reset All to Absent
          </button>
        </div>
      </div>
    <% end %>

    <!-- ============================================================= -->
    <!-- 1. INTERACTIVE 1-TOUCH TILE VIEW (MOBILE-FIRST DEFAULT)       -->
    <!-- ============================================================= -->
    <div id="mode-tiles" class="att-tiles-grid">
      <% @attendance_records.each do |att| %>
        <% emp = att.employee %>
        <% current_status = att.status.presence || "absent" %>

        <div class="worker-tile status-<%= current_status %>" id="tile_<%= emp.id %>">
          <!-- Worker Header Info -->
          <div class="worker-tile-header">
            <div class="worker-info-group">
              <!-- Tap avatar to cycle status! -->
              <div class="worker-avatar-tile" onclick="cycleStatus(<%= emp.id %>)" title="Tap to cycle status (Absent ➔ Present ➔ Half ➔ Leave)">
                <%= emp.name.first.upcase %>
              </div>
              <div class="worker-name-role">
                <h3><%= emp.name %></h3>
                <div class="worker-rate-badge">
                  <%= emp.role_title.presence || "Worker" %> •
                  <% if admin? %>
                    <strong style="color: #fff;"><%= current_business.formatted_currency(emp.base_rate) %></strong>/<%= emp.wage_type == 'daily' ? 'day' : 'rate' %>
                  <% else %>
                    <span><%= emp.wage_type.capitalize %> wage</span>
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Dynamic Status Badge -->
            <div>
              <span id="badge_<%= emp.id %>" class="badge <%= current_status == 'present' ? 'badge-success' : (current_status == 'half_day' ? 'badge-warning' : (current_status == 'absent' ? 'badge-danger' : 'badge-info')) %>"
                    onclick="cycleStatus(<%= emp.id %>)" style="cursor: pointer; font-size: 0.8rem; padding: 0.35rem 0.65rem;">
                <%= { "present" => "✓ Present", "half_day" => "½ Half Day", "absent" => "✗ Absent", "paid_leave" => "🏖️ Leave" }[current_status] || current_status.titleize %>
              </span>
            </div>
          </div>

          <!-- Hidden Radio inputs (synced with tiles) -->
          <div style="display: none;">
            <%= radio_button_tag "attendances[#{emp.id}][status]", "present", current_status == "present", id: "radio_#{emp.id}_present", class: "status-radio-present" %>
            <%= radio_button_tag "attendances[#{emp.id}][status]", "half_day", current_status == "half_day", id: "radio_#{emp.id}_half_day", class: "status-radio-half_day" %>
            <%= radio_button_tag "attendances[#{emp.id}][status]", "absent", current_status == "absent", id: "radio_#{emp.id}_absent", class: "status-radio-absent" %>
            <%= radio_button_tag "attendances[#{emp.id}][status]", "paid_leave", current_status == "paid_leave", id: "radio_#{emp.id}_paid_leave", class: "status-radio-paid_leave" %>
          </div>

          <!-- 1-Touch Segmented Touch Tabs -->
          <div class="touch-tabs-group">
            <button type="button"
                    id="btn_<%= emp.id %>_present"
                    onclick="setStatus(<%= emp.id %>, 'present')"
                    class="touch-tab-btn <%= 'active-present' if current_status == 'present' %>">
              <span class="tab-icon">✓</span>
              <span>Present</span>
            </button>

            <button type="button"
                    id="btn_<%= emp.id %>_half_day"
                    onclick="setStatus(<%= emp.id %>, 'half_day')"
                    class="touch-tab-btn <%= 'active-half_day' if current_status == 'half_day' %>">
              <span class="tab-icon">½</span>
              <span>Half Day</span>
            </button>

            <button type="button"
                    id="btn_<%= emp.id %>_absent"
                    onclick="setStatus(<%= emp.id %>, 'absent')"
                    class="touch-tab-btn <%= 'active-absent' if current_status == 'absent' %>">
              <span class="tab-icon">✗</span>
              <span>Absent</span>
            </button>

            <button type="button"
                    id="btn_<%= emp.id %>_paid_leave"
                    onclick="setStatus(<%= emp.id %>, 'paid_leave')"
                    class="touch-tab-btn <%= 'active-paid_leave' if current_status == 'paid_leave' %>">
              <span class="tab-icon">🏖️</span>
              <span>Leave</span>
            </button>
          </div>

          <!-- Overtime Stepper & Work Project Assignment -->
          <div class="tile-extra-controls">
            <!-- OT Touch Stepper -->
            <div>
              <label class="form-label" style="font-size: 0.72rem; margin-bottom: 2px;">Overtime (Hours)</label>
              <div class="ot-touch-stepper">
                <button type="button" class="ot-step-btn" onclick="adjustOT(<%= emp.id %>, -0.5)">−</button>
                <span class="ot-val-display" id="ot_disp_<%= emp.id %>"><%= att.overtime_hours.to_f > 0 ? "#{att.overtime_hours}h OT" : "0.0h" %></span>
                <button type="button" class="ot-step-btn" onclick="adjustOT(<%= emp.id %>, 0.5)">+</button>
              </div>
              <%= hidden_field_tag "attendances[#{emp.id}][overtime_hours]", att.overtime_hours, id: "ot_input_#{emp.id}" %>
            </div>

            <!-- Project Assignment -->
            <div>
              <label class="form-label" style="font-size: 0.72rem; margin-bottom: 2px;">Work Site / Job</label>
              <%= select_tag "attendances[#{emp.id}][work_project_id]",
                    options_for_select([["🏭 Shop Floor", ""]] + @active_projects.map { |p| ["🏗️ #{p.title.truncate(24)}", p.id] }, att.work_project_id),
                    id: "tile_project_#{emp.id}",
                    onchange: "syncTileProject(#{emp.id}, this.value)",
                    class: "form-select", style: "font-size: 0.8rem; padding: 0.45rem 0.6rem;" %>
            </div>
          </div>

          <!-- Remarks note -->
          <div>
            <%= text_field_tag "attendances[#{emp.id}][notes]", att.notes,
                  id: "tile_notes_#{emp.id}",
                  oninput: "syncTileNotes(#{emp.id}, this.value)",
                  placeholder: "Notes (e.g. came late, site welding)",
                  class: "form-control", style: "font-size: 0.8rem; padding: 0.4rem 0.65rem;" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- ============================================================= -->
    <!-- 2. TRADITIONAL SPREADSHEET TABLE MODE (DESKTOP / ALTERNATIVE) -->
    <!-- ============================================================= -->
    <div id="mode-table" class="card" style="padding: 0.5rem; display: <%= @current_mode == 'table' ? 'block' : 'none' %>; margin-bottom: 1.5rem;">
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th style="min-width: 180px;">Laborer / Employee</th>
              <th style="min-width: 320px;">Attendance Status</th>
              <th style="min-width: 130px;">OT Hours</th>
              <th style="min-width: 190px;">Assigned Work</th>
              <th style="min-width: 160px;">Remarks</th>
            </tr>
          </thead>
          <tbody>
            <% @attendance_records.each do |att| %>
              <% emp = att.employee %>
              <% current_status = att.status.presence || "absent" %>
              <tr>
                <td>
                  <div style="display: flex; align-items: center; gap: 0.6rem;">
                    <div style="width: 30px; height: 30px; border-radius: 6px; background: rgba(79, 70, 229, 0.2); color: #818cf8; font-weight: 700; display: flex; align-items: center; justify-content: center; font-size: 0.78rem; flex-shrink: 0;">
                      <%= emp.name.first.upcase %>
                    </div>
                    <div>
                      <div style="font-weight: 700; color: #fff; font-size: 0.88rem;"><%= emp.name %></div>
                      <div style="font-size: 0.75rem; color: var(--text-dim);">
                        <%= emp.role_title.presence || "Worker" %> • <%= current_business.formatted_currency(emp.base_rate) %>
                      </div>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="tbl-status-group">
                    <button type="button"
                            id="tbl_btn_<%= emp.id %>_present"
                            onclick="setStatus(<%= emp.id %>, 'present')"
                            class="tbl-status-btn <%= 'active-present' if current_status == 'present' %>">
                      <span>✓</span> Present
                    </button>
                    <button type="button"
                            id="tbl_btn_<%= emp.id %>_half_day"
                            onclick="setStatus(<%= emp.id %>, 'half_day')"
                            class="tbl-status-btn <%= 'active-half_day' if current_status == 'half_day' %>">
                      <span>½</span> Half Day
                    </button>
                    <button type="button"
                            id="tbl_btn_<%= emp.id %>_absent"
                            onclick="setStatus(<%= emp.id %>, 'absent')"
                            class="tbl-status-btn <%= 'active-absent' if current_status == 'absent' %>">
                      <span>✗</span> Absent
                    </button>
                    <button type="button"
                            id="tbl_btn_<%= emp.id %>_paid_leave"
                            onclick="setStatus(<%= emp.id %>, 'paid_leave')"
                            class="tbl-status-btn <%= 'active-paid_leave' if current_status == 'paid_leave' %>">
                      <span>🏖️</span> Leave
                    </button>
                  </div>
                </td>
                <td>
                  <div style="display: inline-flex; align-items: center; gap: 4px; background: rgba(0,0,0,0.3); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 3px 5px;">
                    <button type="button" class="btn btn-secondary btn-sm" style="padding: 2px 7px; font-size: 0.75rem; min-height: auto;" onclick="adjustOT(<%= emp.id %>, -0.5)">−</button>
                    <span id="table_ot_disp_<%= emp.id %>" style="min-width: 42px; text-align: center; font-weight: 700; color: #fff; font-size: 0.82rem;"><%= att.overtime_hours.to_f > 0 ? "#{att.overtime_hours}h" : "0.0h" %></span>
                    <button type="button" class="btn btn-secondary btn-sm" style="padding: 2px 7px; font-size: 0.75rem; min-height: auto;" onclick="adjustOT(<%= emp.id %>, 0.5)">+</button>
                  </div>
                </td>
                <td>
                  <%= select_tag "table_project_#{emp.id}",
                        options_for_select([["🏭 Shop Floor", ""]] + @active_projects.map { |p| ["🏗️ #{p.title.truncate(18)}", p.id] }, att.work_project_id),
                        class: "form-select",
                        style: "font-size: 0.8rem; padding: 0.35rem 0.5rem; width: 100%; max-width: 180px;",
                        onchange: "syncProject(#{emp.id}, this.value)" %>
                </td>
                <td>
                  <%= text_field_tag "table_notes_#{emp.id}", att.notes,
                        placeholder: "Notes...",
                        class: "form-control",
                        style: "font-size: 0.8rem; padding: 0.35rem 0.5rem; width: 100%; max-width: 170px;",
                        oninput: "syncNotes(#{emp.id}, this.value)" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Sticky Bottom Mobile Save Bar -->
    <div style="position: sticky; bottom: 74px; z-index: 80; background: rgba(17, 24, 39, 0.95); backdrop-filter: blur(12px); border: 1px solid var(--border-hover); border-radius: var(--radius-md); padding: 0.85rem 1.25rem; display: flex; justify-content: space-between; align-items: center; box-shadow: var(--shadow-lg); margin-top: 1.5rem;">
      <div style="font-size: 0.88rem; color: #fff;">
        <span style="color: var(--text-muted);">Ready to save:</span> <strong><%= @selected_date.strftime("%d %b %Y") %></strong>
      </div>
      <div>
        <%= f.submit "💾 Save Attendance", class: "btn btn-primary btn-lg", style: "min-height: 48px; padding: 0.65rem 1.5rem; font-weight: 700;" %>
      </div>
    </div>
  <% end %>
<% end %>

<!-- 1-Touch Attendance JavaScript -->
<script>
  function setStatus(empId, status) {
    // 1. Check the hidden radio button
    const radio = document.getElementById(`radio_${empId}_${status}`);
    if (radio) {
      radio.checked = true;
    }

    // 2. Update segmented tab styling (Tile mode)
    const tile = document.getElementById(`tile_${empId}`);
    if (tile) {
      tile.querySelectorAll('.touch-tab-btn').forEach(btn => {
        btn.className = 'touch-tab-btn';
      });

      const activeBtn = document.getElementById(`btn_${empId}_${status}`);
      if (activeBtn) {
        activeBtn.className = `touch-tab-btn active-${status}`;
      }

      // 3. Update worker tile card border & atmospheric background
      tile.className = `worker-tile status-${status}`;

      // 4. Update the visual badge
      const badge = document.getElementById(`badge_${empId}`);
      if (badge) {
        const labels = {
          present: '✓ Present',
          half_day: '½ Half Day',
          absent: '✗ Absent',
          paid_leave: '🏖️ Leave'
        };
        const badgeClasses = {
          present: 'badge badge-success',
          half_day: 'badge badge-warning',
          absent: 'badge badge-danger',
          paid_leave: 'badge badge-info'
        };
        badge.textContent = labels[status] || status;
        badge.className = badgeClasses[status] || 'badge';
      }
    }

    // 5. Update Table Mode buttons
    ['present', 'half_day', 'absent', 'paid_leave'].forEach(s => {
      const tblBtn = document.getElementById(`tbl_btn_${empId}_${s}`);
      if (tblBtn) {
        if (s === status) {
          tblBtn.className = `tbl-status-btn active-${s}`;
        } else {
          tblBtn.className = 'tbl-status-btn';
        }
      }
    });

    recalcSummaryCounts();
  }

  // 1-Touch single-touch cycle: Absent ➔ Present ➔ Half Day ➔ Paid Leave ➔ Absent
  function cycleStatus(empId) {
    const statuses = ['absent', 'present', 'half_day', 'paid_leave'];
    const currentRadio = document.querySelector(`input[name="attendances[${empId}][status]"]:checked`);
    const currentStatus = currentRadio ? currentRadio.value : 'absent';
    const nextIdx = (statuses.indexOf(currentStatus) + 1) % statuses.length;
    setStatus(empId, statuses[nextIdx]);
  }

  // Overtime +/- Stepper
  function adjustOT(empId, delta) {
    const input = document.getElementById(`ot_input_${empId}`);
    const display = document.getElementById(`ot_disp_${empId}`);
    const tableDisp = document.getElementById(`table_ot_disp_${empId}`);
    if (input) {
      let val = (parseFloat(input.value) || 0) + delta;
      val = Math.max(0, Math.round(val * 10) / 10);
      input.value = val;
      const otText = val > 0 ? (val + 'h OT') : '0.0h';
      const tblText = val > 0 ? (val + 'h') : '0.0h';
      if (display) display.textContent = otText;
      if (tableDisp) tableDisp.textContent = tblText;
    }
  }

  // Two-way synchronization between Tile controls and Table controls
  function syncProject(empId, val) {
    const tileSelect = document.getElementById(`tile_project_${empId}`);
    if (tileSelect) tileSelect.value = val;
  }

  function syncNotes(empId, val) {
    const tileNotes = document.getElementById(`tile_notes_${empId}`);
    if (tileNotes) tileNotes.value = val;
  }

  function syncTileProject(empId, val) {
    const tblSelect = document.getElementById(`table_project_${empId}`);
    if (tblSelect) tblSelect.value = val;
  }

  function syncTileNotes(empId, val) {
    const tblNotes = document.getElementById(`table_notes_${empId}`);
    if (tblNotes) tblNotes.value = val;
  }

  // Bulk actions for manager
  function setAllWorkers(status) {
    document.querySelectorAll('.worker-tile').forEach(tile => {
      const empId = tile.id.replace('tile_', '');
      setStatus(empId, status);
    });
  }

  // Live summary counter
  function recalcSummaryCounts() {
    let p = 0, h = 0, a = 0;
    document.querySelectorAll('.status-radio-present:checked').forEach(() => p++);
    document.querySelectorAll('.status-radio-half_day:checked').forEach(() => h++);
    document.querySelectorAll('.status-radio-absent:checked').forEach(() => a++);

    const pElem = document.getElementById('summary-present-count');
    const hElem = document.getElementById('summary-half-count');
    const aElem = document.getElementById('summary-absent-count');

    if (pElem) pElem.textContent = p;
    if (hElem) hElem.textContent = h;
    if (aElem) aElem.textContent = a;
  }

  // Mode switcher (Tiles vs Table)
  function switchAttMode(mode) {
    const tilesDiv = document.getElementById('mode-tiles');
    const tableDiv = document.getElementById('mode-table');
    const btnTiles = document.getElementById('tab-btn-tiles');
    const btnTable = document.getElementById('tab-btn-table');
    const dateNavMode = document.getElementById('date-nav-mode');

    if (!tilesDiv || !tableDiv) return;

    if (mode === 'tiles') {
      tilesDiv.style.display = 'grid';
      tableDiv.style.display = 'none';
      if (btnTiles) btnTiles.className = 'att-view-tab active';
      if (btnTable) btnTable.className = 'att-view-tab';
      if (dateNavMode) dateNavMode.value = 'tiles';
      localStorage.setItem('att_view_mode', 'tiles');
      try {
        const url = new URL(window.location);
        url.searchParams.set('mode', 'tiles');
        window.history.replaceState({}, '', url);
      } catch (e) {}
    } else {
      tilesDiv.style.display = 'none';
      tableDiv.style.display = 'block';
      if (btnTiles) btnTiles.className = 'att-view-tab';
      if (btnTable) btnTable.className = 'att-view-tab active';
      if (dateNavMode) dateNavMode.value = 'table';
      localStorage.setItem('att_view_mode', 'table');
      try {
        const url = new URL(window.location);
        url.searchParams.set('mode', 'table');
        window.history.replaceState({}, '', url);
      } catch (e) {}
    }
  }

  // Auto-restore preferred mode on page load
  document.addEventListener('DOMContentLoaded', function() {
    const urlParams = new URLSearchParams(window.location.search);
    const mode = urlParams.get('mode') || localStorage.getItem('att_view_mode');
    if (mode) {
      switchAttMode(mode);
    }
  });
</script>
