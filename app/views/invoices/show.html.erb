<% content_for :page_title do %>
  <span><%= @invoice.doc_type.capitalize %>: <%= @invoice.invoice_number %></span>
<% end %>

<!-- Top Header & Actions -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <h2 style="font-size: 1.5rem; font-weight: 800; color: #fff;"><%= @invoice.invoice_number %></h2>
      <span class="badge <%= @invoice.quotation? ? 'badge-info' : 'badge-neutral' %>"><%= @invoice.doc_type.upcase %></span>
      <span class="badge <%= @invoice.status == 'paid' ? 'badge-success' : (@invoice.status == 'partial' ? 'badge-warning' : 'badge-neutral') %>">
        <%= @invoice.status.titleize %>
      </span>
    </div>
    <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 0.2rem;">
      Issued: <%= @invoice.issue_date.strftime("%d %B %Y") %> • Due: <%= @invoice.due_date&.strftime("%d %B %Y") || "On Presentation" %>
    </p>
  </div>

  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
    <% if @invoice.quotation? %>
      <%= button_to "⚡ Convert to Tax Invoice", convert_to_invoice_invoice_path(@invoice), method: :post, data: { turbo_confirm: "Convert this quotation into an active tax invoice?" }, class: "btn btn-success" %>
    <% end %>
    <%= link_to "🖨️ Print / PDF View", print_invoice_path(@invoice), target: "_blank", class: "btn btn-primary" %>
    <%= link_to "Edit", edit_invoice_path(@invoice), class: "btn btn-secondary" %>
    <%= link_to "← Documents List", invoices_path, class: "btn btn-secondary" %>
  </div>
</div>

<!-- Main Invoice Sheet Card -->
<div class="card" style="margin-bottom: 2rem;">
  <!-- Header with Business & Client details -->
  <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-subtle); padding-bottom: 1.5rem; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1.5rem;">
    <div>
      <div style="font-size: 0.78rem; text-transform: uppercase; color: var(--text-dim); font-weight: 700; margin-bottom: 0.35rem;">FROM:</div>
      <h3 style="font-size: 1.2rem; font-weight: 800; color: #fff;"><%= current_business.name %></h3>
      <div style="color: var(--text-muted); font-size: 0.85rem;"><%= current_business.address %></div>
      <div style="color: var(--text-muted); font-size: 0.85rem;">Phone: <%= current_business.phone %> • Email: <%= current_business.email %></div>
      <% if current_business.tax_id.present? %>
        <div style="color: var(--text-muted); font-size: 0.85rem;">GSTIN / Tax ID: <strong><%= current_business.tax_id %></strong></div>
      <% end %>
    </div>

    <div>
      <div style="font-size: 0.78rem; text-transform: uppercase; color: var(--text-dim); font-weight: 700; margin-bottom: 0.35rem;">BILLED TO:</div>
      <h3 style="font-size: 1.2rem; font-weight: 800; color: #fff;"><%= @invoice.client&.name || "Direct Client / Walk-in" %></h3>
      <% if @invoice.client&.company_name.present? %>
        <div style="font-size: 0.88rem; color: #cbd5e1; font-weight: 600;"><%= @invoice.client.company_name %></div>
      <% end %>
      <div style="color: var(--text-muted); font-size: 0.85rem;"><%= @invoice.client&.address %></div>
      <div style="color: var(--text-muted); font-size: 0.85rem;">Phone: <%= @invoice.client&.phone %></div>
      <% if @invoice.client&.tax_id.present? %>
        <div style="color: var(--text-muted); font-size: 0.85rem;">Client Tax ID: <%= @invoice.client.tax_id %></div>
      <% end %>
    </div>
  </div>

  <% if @invoice.work_project.present? %>
    <div style="background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.25); border-radius: var(--radius-sm); padding: 0.75rem 1rem; margin-bottom: 1.5rem; font-size: 0.88rem;">
      🏗️ Associated Project: <strong><%= link_to @invoice.work_project.title, work_project_path(@invoice.work_project), style: "color: #818cf8;" %></strong>
    </div>
  <% end %>

  <!-- Line Items Table -->
  <div class="table-responsive" style="margin-bottom: 1.5rem;">
    <table class="data-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Description</th>
          <th style="text-align: right;">Quantity</th>
          <th style="text-align: right;">Unit Rate</th>
          <th style="text-align: right;">Total Amount</th>
        </tr>
      </thead>
      <tbody>
        <% @items.each_with_index do |item, idx| %>
          <tr>
            <td style="color: var(--text-dim);"><%= idx + 1 %></td>
            <td style="font-weight: 600; color: #fff;"><%= item.description %></td>
            <td style="text-align: right;"><%= item.quantity %></td>
            <td style="text-align: right;"><%= current_business.formatted_currency(item.unit_price) %></td>
            <td style="text-align: right; font-weight: 700; color: #fff;">
              <%= current_business.formatted_currency(item.total_price) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- Totals Section -->
  <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 2rem; border-top: 1px solid var(--border-subtle); padding-top: 1.5rem;">
    <div style="flex: 1; min-width: 280px;">
      <% if @invoice.terms.present? %>
        <div style="font-size: 0.8rem; font-weight: 700; color: var(--text-muted); margin-bottom: 0.25rem;">PAYMENT INSTRUCTIONS & TERMS:</div>
        <div style="font-size: 0.85rem; color: #cbd5e1; background: rgba(0, 0, 0, 0.25); padding: 0.75rem; border-radius: var(--radius-sm);"><%= simple_format(@invoice.terms) %></div>
      <% end %>
      <% if @invoice.notes.present? %>
        <div style="font-size: 0.85rem; color: var(--text-dim); margin-top: 0.75rem;">Remarks: <%= @invoice.notes %></div>
      <% end %>
    </div>

    <div style="width: 300px; display: flex; flex-direction: column; gap: 0.65rem;">
      <div style="display: flex; justify-content: space-between; font-size: 0.9rem;">
        <span style="color: var(--text-muted);">Subtotal:</span>
        <span style="font-weight: 600; color: #fff;"><%= current_business.formatted_currency(@invoice.subtotal) %></span>
      </div>

      <% if @invoice.discount_amount.to_f > 0 %>
        <div style="display: flex; justify-content: space-between; font-size: 0.9rem;">
          <span style="color: var(--text-muted);">Discount:</span>
          <span style="color: var(--danger-text);">-<%= current_business.formatted_currency(@invoice.discount_amount) %></span>
        </div>
      <% end %>

      <% if @invoice.tax_rate.to_f > 0 %>
        <div style="display: flex; justify-content: space-between; font-size: 0.9rem;">
          <span style="color: var(--text-muted);">Tax / GST (<%= @invoice.tax_rate %>%):</span>
          <span style="font-weight: 600; color: #fff;"><%= current_business.formatted_currency(@invoice.tax_amount) %></span>
        </div>
      <% end %>

      <div style="display: flex; justify-content: space-between; font-size: 1.35rem; font-weight: 800; border-top: 2px solid var(--border-subtle); padding-top: 0.75rem; color: #fff;">
        <span>Total Amount:</span>
        <span style="color: #34d399;"><%= current_business.formatted_currency(@invoice.total_amount) %></span>
      </div>

      <% if @invoice.invoice? %>
        <div style="display: flex; justify-content: space-between; font-size: 0.9rem; color: var(--success-text);">
          <span>Amount Paid:</span>
          <span><%= current_business.formatted_currency(@invoice.paid_amount) %></span>
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 1.1rem; font-weight: 700; color: #fbbf24; border-top: 1px dashed var(--border-subtle); padding-top: 0.5rem;">
          <span>Balance Due:</span>
          <span><%= current_business.formatted_currency(@invoice.balance_amount) %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- If invoice, Payment Collection Ledger & Recording Box -->
<% if @invoice.invoice? %>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    <!-- Record Payment Form -->
    <div class="card">
      <div class="card-header">
        <div class="card-title">
          <span>💰</span> Record Client Payment
        </div>
        <span class="badge <%= @invoice.balance_amount <= 0 ? 'badge-success' : 'badge-warning' %>">
          Due: <%= current_business.formatted_currency(@invoice.balance_amount) %>
        </span>
      </div>

      <% if @invoice.balance_amount <= 0 %>
        <div style="text-align: center; padding: 2rem; color: var(--success-text); font-weight: 600;">
          ✓ This invoice has been paid in full!
        </div>
      <% else %>
        <%= form_with model: [@invoice, @new_payment], local: true do |pf| %>
          <div class="form-group">
            <%= pf.label :amount, "Amount Received (#{current_business.currency_symbol}) *", class: "form-label" %>
            <%= pf.number_field :amount, step: "1.0", max: @invoice.balance_amount, required: true, class: "form-control", style: "font-size: 1.35rem; font-weight: 700; color: #34d399;" %>
          </div>

          <div class="form-row">
            <div class="form-group">
              <%= pf.label :date, "Payment Date *", class: "form-label" %>
              <%= pf.date_field :date, required: true, class: "form-control" %>
            </div>
            <div class="form-group">
              <%= pf.label :payment_mode, "Payment Mode", class: "form-label" %>
              <%= pf.select :payment_mode, [["UPI / PhonePe / GPay", "upi"], ["Cash", "cash"], ["Bank Transfer / NEFT", "bank"], ["Cheque", "cheque"]], {}, class: "form-select" %>
            </div>
          </div>

          <div class="form-group">
            <%= pf.label :transaction_ref, "UTR / Transaction Ref Number", class: "form-label" %>
            <%= pf.text_field :transaction_ref, placeholder: "e.g. UPI Ref: 32901239102", class: "form-control" %>
          </div>

          <div style="margin-top: 1rem;">
            <%= pf.submit "Record Payment Receipt", class: "btn btn-success btn-lg", style: "width: 100%;" %>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- Payment Receipts History -->
    <div class="card">
      <div class="card-header">
        <div class="card-title">
          <span>📜</span> Payment Receipts History
        </div>
      </div>

      <% if @payments.empty? %>
        <div style="text-align: center; padding: 2rem; color: var(--text-muted);">
          No payments recorded yet.
        </div>
      <% else %>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Amount</th>
                <th>Mode</th>
                <th>Ref</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% @payments.each do |p| %>
                <tr>
                  <td><%= p.date.strftime("%d %b %Y") %></td>
                  <td style="font-weight: 700; color: var(--success-text);">
                    <%= current_business.formatted_currency(p.amount) %>
                  </td>
                  <td><span class="badge badge-neutral"><%= p.payment_mode.upcase %></span></td>
                  <td style="font-size: 0.8rem; color: var(--text-dim);"><%= p.transaction_ref.presence || "-" %></td>
                  <td>
                    <%= button_to "✕", invoice_payment_receipt_path(@invoice, p), method: :delete, data: { turbo_confirm: "Delete this payment receipt?" }, class: "btn btn-danger btn-sm", style: "padding: 0.2rem 0.5rem;" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
