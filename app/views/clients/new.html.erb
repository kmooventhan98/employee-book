<% content_for :page_title do %>
  <span>New Client</span>
<% end %>

<div style="max-width: 650px; margin: 0 auto;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <div>
      <h2 style="font-size: 1.4rem; font-weight: 800; color: #fff;">👥 Add Client / Customer</h2>
      <p style="color: var(--text-muted); font-size: 0.85rem;">Store contact details for invoices, quotations, and projects</p>
    </div>
    <%= link_to "← Clients List", clients_path, class: "btn btn-secondary btn-sm" %>
  </div>

  <div class="card">
    <%= render "form", client: @client %>
  </div>
</div>
