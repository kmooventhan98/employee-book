<% content_for :page_title do %>
  <span>Give Advance: <%= @employee.name %></span>
<% end %>

<div style="max-width: 600px; margin: 0 auto;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <div>
      <h2 style="font-size: 1.4rem; font-weight: 800; color: #fff;">💸 Give Cash Advance (Khata)</h2>
      <p style="color: var(--text-muted); font-size: 0.85rem;">Worker: <strong style="color: #fff;"><%= @employee.name %></strong></p>
    </div>
    <%= link_to "← Back to Profile", employee_path(@employee), class: "btn btn-secondary btn-sm" %>
  </div>

  <div class="card">
    <div style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.25); border-radius: var(--radius-sm); padding: 0.85rem 1rem; margin-bottom: 1.25rem; font-size: 0.85rem; color: #fbbf24;">
      ℹ️ Currently outstanding advances for <%= @employee.name %>: <strong><%= current_business.formatted_currency(@employee.total_advances_pending) %></strong>
    </div>

    <%= form_with model: [@employee, @advance_payment], local: true do |f| %>
      <% if @advance_payment.errors.any? %>
        <div class="alert alert-danger">
          <%= @advance_payment.errors.full_messages.join(", ") %>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :amount, "Advance Amount (#{current_business.currency_symbol}) *", class: "form-label" %>
        <%= f.number_field :amount, step: "1.0", required: true, autofocus: true, placeholder: "e.g. 500", class: "form-control", style: "font-size: 1.35rem; font-weight: 700; color: #fff;" %>
      </div>

      <div class="form-row">
        <div class="form-group">
          <%= f.label :date, "Date Given *", class: "form-label" %>
          <%= f.date_field :date, required: true, class: "form-control" %>
        </div>
        <div class="form-group">
          <%= f.label :payment_mode, "Payment Mode", class: "form-label" %>
          <%= f.select :payment_mode, [["Cash", "cash"], ["UPI / PhonePe / GPay", "upi"], ["Bank Transfer", "bank"]], {}, class: "form-select" %>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :reason, "Reason / Note (Optional)", class: "form-label" %>
        <%= f.text_field :reason, placeholder: "e.g. Family emergency, festival advance, medical expense", class: "form-control" %>
      </div>

      <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
        <%= f.submit "Record Advance Payment", class: "btn btn-primary btn-lg", style: "flex: 1;" %>
        <%= link_to "Cancel", employee_path(@employee), class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
