<% content_for :page_title do %>
  <span>Edit: <%= @client.name %></span>
<% end %>

<div style="max-width: 650px; margin: 0 auto;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <div>
      <h2 style="font-size: 1.4rem; font-weight: 800; color: #fff;">Edit Client: <%= @client.name %></h2>
      <p style="color: var(--text-muted); font-size: 0.85rem;">Modify contact or billing info</p>
    </div>
    <div style="display: flex; gap: 0.5rem;">
      <%= link_to "View Profile", client_path(@client), class: "btn btn-secondary btn-sm" %>
      <%= link_to "← Back", clients_path, class: "btn btn-secondary btn-sm" %>
    </div>
  </div>

  <div class="card">
    <%= render "form", client: @client %>
  </div>
</div>
