<% content_for :page_title do %>
  <span>Daily Attendance Register</span>
<% end %>

<!-- Top Header with Date Navigation -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h2 style="font-size: 1.4rem; font-weight: 800; color: #fff;">📝 Daily Attendance & Labor Log</h2>
    <p style="color: var(--text-muted); font-size: 0.85rem;">
      Mark daily attendance, overtime, and assign laborers to active sites/works
    </p>
  </div>

  <!-- Date Selector -->
  <%= form_with url: bulk_attendances_path, method: :get, local: true, style: "display: flex; align-items: center; gap: 0.5rem;" do |df| %>
    <%= link_to "← Yesterday", bulk_attendances_path(date: @selected_date - 1.day), class: "btn btn-secondary btn-sm" %>
    <%= df.date_field :date, value: @selected_date, onchange: "this.form.submit();", class: "form-control", style: "width: auto; padding: 0.4rem 0.75rem;" %>
    <%= link_to "Tomorrow →", bulk_attendances_path(date: @selected_date + 1.day), class: "btn btn-secondary btn-sm" %>
    <% unless @selected_date == Date.current %>
      <%= link_to "Today", bulk_attendances_path(date: Date.current), class: "btn btn-primary btn-sm" %>
    <% end %>
  <% end %>
</div>

<!-- Daily Summary Metrics -->
<div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); margin-bottom: 1.5rem;">
  <div class="stat-card success" style="padding: 1rem 1.25rem;">
    <div class="stat-meta">
      <div class="stat-label">Present</div>
      <div class="stat-value" style="color: var(--success-text);"><%= @present_count %> / <%= @total_laborers %></div>
    </div>
  </div>

  <div class="stat-card warning" style="padding: 1rem 1.25rem;">
    <div class="stat-meta">
      <div class="stat-label">Half Day</div>
      <div class="stat-value" style="color: var(--warning-text);"><%= @half_count %></div>
    </div>
  </div>

  <div class="stat-card danger" style="padding: 1rem 1.25rem;">
    <div class="stat-meta">
      <div class="stat-label">Absent</div>
      <div class="stat-value" style="color: var(--danger-text);"><%= @absent_count %></div>
    </div>
  </div>

  <div class="stat-card primary" style="padding: 1rem 1.25rem;">
    <div class="stat-meta">
      <div class="stat-label">Day's Total Wage Cost</div>
      <div class="stat-value"><%= current_business.formatted_currency(@total_day_wage) %></div>
    </div>
  </div>
</div>

<% if @employees.empty? %>
  <div class="card" style="text-align: center; padding: 3rem 1rem;">
    <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">👷</div>
    <h3 style="color: #fff; margin-bottom: 0.5rem;">No active employees found</h3>
    <p style="color: var(--text-muted); margin-bottom: 1rem;">Add your laborers to start marking their daily attendance and wages.</p>
    <%= link_to "+ Add Employee", new_employee_path, class: "btn btn-primary" %>
  </div>
<% else %>
  <%= form_with url: bulk_update_attendances_path, method: :post, local: true do |f| %>
    <%= hidden_field_tag :date, @selected_date %>

    <div class="card" style="padding: 0.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; border-bottom: 1px solid var(--border-subtle); flex-wrap: wrap; gap: 0.5rem;">
        <div style="font-weight: 700; color: #fff;">
          <%= @selected_date.strftime("%A, %d %B %Y") %>
        </div>
        <div style="display: flex; gap: 0.5rem;">
          <button type="button" onclick="document.querySelectorAll('.radio-present').forEach(el => el.checked = true);" class="btn btn-secondary btn-sm">
            ✓ Set All Present
          </button>
        </div>
      </div>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th style="min-width: 180px;">Laborer / Employee</th>
              <th style="min-width: 250px;">Attendance Status</th>
              <th style="min-width: 110px;">Overtime (hrs)</th>
              <th style="min-width: 200px;">Assign to Work / Project</th>
              <th style="min-width: 150px;">Remarks</th>
            </tr>
          </thead>
          <tbody>
            <% @attendance_records.each do |att| %>
              <% emp = att.employee %>
              <tr>
                <td>
                  <div style="font-weight: 700; color: #fff;"><%= emp.name %></div>
                  <div style="font-size: 0.75rem; color: var(--text-dim);">
                    <%= emp.role_title.presence || "Worker" %> • <%= current_business.formatted_currency(emp.base_rate) %>/<%= emp.wage_type == 'daily' ? 'day' : 'rate' %>
                  </div>
                </td>

                <td>
                  <div style="display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap;">
                    <label style="display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.8rem; cursor: pointer; padding: 0.35rem 0.6rem; border-radius: var(--radius-sm); background: rgba(16, 185, 129, 0.12); color: var(--success-text);">
                      <%= radio_button_tag "attendances[#{emp.id}][status]", "present", att.status == "present", class: "radio-present" %>
                      <span>Present</span>
                    </label>

                    <label style="display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.8rem; cursor: pointer; padding: 0.35rem 0.6rem; border-radius: var(--radius-sm); background: rgba(245, 158, 11, 0.12); color: var(--warning-text);">
                      <%= radio_button_tag "attendances[#{emp.id}][status]", "half_day", att.status == "half_day" %>
                      <span>Half Day</span>
                    </label>

                    <label style="display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.8rem; cursor: pointer; padding: 0.35rem 0.6rem; border-radius: var(--radius-sm); background: rgba(239, 68, 68, 0.12); color: var(--danger-text);">
                      <%= radio_button_tag "attendances[#{emp.id}][status]", "absent", att.status == "absent" %>
                      <span>Absent</span>
                    </label>

                    <label style="display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.8rem; cursor: pointer; padding: 0.35rem 0.6rem; border-radius: var(--radius-sm); background: rgba(59, 130, 246, 0.12); color: var(--info-text);">
                      <%= radio_button_tag "attendances[#{emp.id}][status]", "paid_leave", att.status == "paid_leave" %>
                      <span>Leave</span>
                    </label>
                  </div>
                </td>

                <td>
                  <%= number_field_tag "attendances[#{emp.id}][overtime_hours]", att.overtime_hours, step: "0.5", min: 0, class: "form-control", style: "width: 80px;" %>
                </td>

                <td>
                  <%= select_tag "attendances[#{emp.id}][work_project_id]", options_for_select([["General / Shop Floor", ""]] + @active_projects.map { |p| ["#{p.title} (#{p.client&.name || 'Direct'})", p.id] }, att.work_project_id), class: "form-select", style: "font-size: 0.85rem;" %>
                </td>

                <td>
                  <%= text_field_tag "attendances[#{emp.id}][notes]", att.notes, placeholder: "e.g. Came late, site A", class: "form-control", style: "font-size: 0.85rem;" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div style="padding: 1.25rem; border-top: 1px solid var(--border-subtle); display: flex; justify-content: flex-end; gap: 0.75rem;">
        <%= f.submit "💾 Save Attendance for #{@selected_date.strftime('%d %b %Y')}", class: "btn btn-primary btn-lg" %>
      </div>
    </div>
  <% end %>
<% end %>
