# Docker & Rails Environment Variables
# Copy this file to .env before starting docker-compose if needed:
# cp .env.example .env

# Your Rails Master Key (found in config/master.key)
RAILS_MASTER_KEY=3d92e6d8a3b907b699a7c192d872365d

# Port exposed to host (default: 3000)
PORT=3000

# Logging
RAILS_LOG_TO_STDOUT=true

# Set to true in production behind HTTPS reverse proxy
RAILS_FORCE_SSL=false
RAILS_ASSUME_SSL=false

# Embedded background jobs via Solid Queue inside Puma
SOLID_QUEUE_IN_PUMA=true
