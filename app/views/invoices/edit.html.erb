<% content_for :page_title do %>
  <span>Edit: <%= @invoice.invoice_number %></span>
<% end %>

<div style="max-width: 850px; margin: 0 auto;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <div>
      <h2 style="font-size: 1.4rem; font-weight: 800; color: #fff;">
        Edit <%= @invoice.doc_type.capitalize %>: <%= @invoice.invoice_number %>
      </h2>
      <p style="color: var(--text-muted); font-size: 0.85rem;">Update line items, rates, or terms</p>
    </div>
    <div style="display: flex; gap: 0.5rem;">
      <%= link_to "View Document", invoice_path(@invoice), class: "btn btn-secondary btn-sm" %>
      <%= link_to "← Documents List", invoices_path, class: "btn btn-secondary btn-sm" %>
    </div>
  </div>

  <div class="card">
    <%= render "form", invoice: @invoice %>
  </div>
</div>
