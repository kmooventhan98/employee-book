<% content_for :page_title do %>
  <span>Work-wise Profit & Loss</span>
<% end %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h2 style="font-size: 1.4rem; font-weight: 800; color: #fff;">🎯 Work-wise Profit & Loss (Job Costing)</h2>
    <p style="color: var(--text-muted); font-size: 0.85rem;">
      See which projects generated highest profits and which jobs had cost overruns
    </p>
  </div>
  <button onclick="window.print();" class="btn btn-secondary btn-sm">🖨️ Print Report</button>
</div>

<!-- Overall Job Portfolio Financials -->
<div class="stats-grid" style="margin-bottom: 2rem;">
  <div class="stat-card primary">
    <div class="stat-icon primary">🏢</div>
    <div class="stat-meta">
      <div class="stat-label">Total Portfolio Billed</div>
      <div class="stat-value"><%= current_business.formatted_currency(@total_billed_all) %></div>
      <div class="stat-subtext">Across <%= @projects.count %> projects</div>
    </div>
  </div>

  <div class="stat-card warning">
    <div class="stat-icon warning">👷</div>
    <div class="stat-meta">
      <div class="stat-label">Total Direct Labor</div>
      <div class="stat-value"><%= current_business.formatted_currency(@total_labor_all) %></div>
    </div>
  </div>

  <div class="stat-card danger">
    <div class="stat-icon danger">📦</div>
    <div class="stat-meta">
      <div class="stat-label">Total Direct Expenses</div>
      <div class="stat-value"><%= current_business.formatted_currency(@total_expenses_all) %></div>
    </div>
  </div>

  <div class="stat-card <%= @total_net_profit_all >= 0 ? 'success' : 'danger' %>">
    <div class="stat-icon <%= @total_net_profit_all >= 0 ? 'success' : 'danger' %>">
      <%= @total_net_profit_all >= 0 ? '💰' : '📉' %>
    </div>
    <div class="stat-meta">
      <div class="stat-label">Total Net Portfolio Profit</div>
      <div class="stat-value" style="color: <%= @total_net_profit_all >= 0 ? 'var(--success-text)' : 'var(--danger-text)' %>;">
        <%= current_business.formatted_currency(@total_net_profit_all) %>
      </div>
      <div class="stat-subtext">Overall Margin: <strong style="color: #fff;"><%= @overall_margin %>%</strong></div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div class="card-title">
      <span>🏗️</span> Job Costing & Profitability Breakdown
    </div>
  </div>

  <% if @projects.empty? %>
    <div style="text-align: center; padding: 3rem 1rem;">
      <p style="color: var(--text-muted);">No works or projects created yet.</p>
      <%= link_to "+ Create First Project", new_work_project_path, class: "btn btn-primary btn-sm" %>
    </div>
  <% else %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Work / Project</th>
            <th>Client</th>
            <th>Status</th>
            <th style="text-align: right;">Billed / Quoted</th>
            <th style="text-align: right;">Direct Labor</th>
            <th style="text-align: right;">Direct Expenses</th>
            <th style="text-align: right;">Total Cost</th>
            <th style="text-align: right;">Net Profit</th>
            <th style="text-align: right;">Margin %</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% @projects.each do |p| %>
            <% net_p = p.net_profit %>
            <% margin = p.profit_margin_pct %>
            <tr>
              <td>
                <div style="font-weight: 700; color: #fff;">
                  <%= link_to p.title, work_project_path(p) %>
                </div>
              </td>
              <td><%= p.client&.display_name || "Direct" %></td>
              <td>
                <span class="badge <%= p.status == 'completed' ? 'badge-success' : (p.status == 'in_progress' ? 'badge-info' : 'badge-neutral') %>">
                  <%= p.status.titleize %>
                </span>
              </td>
              <td style="text-align: right; font-weight: 700;">
                <%= current_business.formatted_currency(p.total_billed) %>
              </td>
              <td style="text-align: right; color: #fbbf24;">
                <%= current_business.formatted_currency(p.total_labor_cost) %>
              </td>
              <td style="text-align: right; color: var(--danger-text);">
                <%= current_business.formatted_currency(p.total_expenses_cost) %>
              </td>
              <td style="text-align: right; color: var(--text-muted);">
                <%= current_business.formatted_currency(p.total_cost) %>
              </td>
              <td style="text-align: right; font-weight: 800; font-size: 0.95rem; color: <%= net_p >= 0 ? 'var(--success-text)' : 'var(--danger-text)' %>;">
                <%= current_business.formatted_currency(net_p) %>
              </td>
              <td style="text-align: right;">
                <span class="badge <%= net_p >= 0 ? 'badge-success' : 'badge-danger' %>">
                  <%= net_p >= 0 ? "+#{margin}%" : "#{margin}%" %>
                </span>
              </td>
              <td>
                <%= link_to "Details", work_project_path(p), class: "btn btn-secondary btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr style="font-weight: 800; font-size: 1rem; border-top: 3px solid var(--border-subtle); background: rgba(0, 0, 0, 0.25);">
            <td colspan="3" style="color: #fff;">PORTFOLIO TOTALS</td>
            <td style="text-align: right; color: #fff;"><%= current_business.formatted_currency(@total_billed_all) %></td>
            <td style="text-align: right; color: #fbbf24;"><%= current_business.formatted_currency(@total_labor_all) %></td>
            <td style="text-align: right; color: var(--danger-text);"><%= current_business.formatted_currency(@total_expenses_all) %></td>
            <td style="text-align: right; color: var(--text-muted);"><%= current_business.formatted_currency(@total_cost_all) %></td>
            <td style="text-align: right; color: <%= @total_net_profit_all >= 0 ? 'var(--success-text)' : 'var(--danger-text)' %>;">
              <%= current_business.formatted_currency(@total_net_profit_all) %>
            </td>
            <td style="text-align: right;">
              <span class="badge <%= @total_net_profit_all >= 0 ? 'badge-success' : 'badge-danger' %>"><%= @overall_margin %>%</span>
            </td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% end %>
</div>
