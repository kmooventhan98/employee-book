<% content_for :page_title do %>
  <span>Edit Expense</span>
<% end %>

<div style="max-width: 650px; margin: 0 auto;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <div>
      <h2 style="font-size: 1.4rem; font-weight: 800; color: #fff;">Edit Expense Entry</h2>
      <p style="color: var(--text-muted); font-size: 0.85rem;">Modify amount, category, or project attribution</p>
    </div>
    <%= link_to "← Back", expenses_path, class: "btn btn-secondary btn-sm" %>
  </div>

  <div class="card">
    <%= render "form", expense: @expense %>
  </div>
</div>
