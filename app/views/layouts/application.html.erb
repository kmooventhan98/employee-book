<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} — KarigarBook" : "KarigarBook — Small Business Labor & Financial OS" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="KarigarBook">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#0a0e17">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if authenticated? %>
      <div class="app-layout">
        <!-- Desktop Sidebar -->
        <aside class="sidebar">
          <div class="sidebar-header">
            <div class="brand-icon"><%= current_business&.logo_initials || "KB" %></div>
            <div class="brand-info">
              <h1><%= current_business&.name || "KarigarBook Platform" %></h1>
              <% if current_business.present? %>
                <span class="brand-badge"><%= current_business.currency_code %> (<%= current_business.currency_symbol %>)</span>
              <% else %>
                <span class="brand-badge" style="color: #fbbf24;">Platform Console</span>
              <% end %>
            </div>
          </div>

          <nav class="nav-group">
            <% if super_admin? %>
              <!-- Super Admin Platform Links -->
              <div class="nav-label" style="color: #fbbf24;">👑 Platform Console</div>
              <%= link_to super_admin_root_path, class: "nav-link #{'active' if request.path.start_with?('/super_admin') && !request.path.include?('/businesses')}" do %>
                <span class="nav-icon">📊</span> Platform Analytics
              <% end %>
              <%= link_to super_admin_businesses_path, class: "nav-link #{'active' if request.path.include?('/super_admin/businesses')}" do %>
                <span class="nav-icon">🏢</span> Onboarded Businesses
              <% end %>
              <%= link_to new_super_admin_business_path, class: "nav-link" do %>
                <span class="nav-icon">➕</span> Onboard New Business
              <% end %>
              <% if Rails.env.development? %>
                <%= link_to "/letter_opener", target: "_blank", class: "nav-link" do %>
                  <span class="nav-icon">📬</span> Dev Mailbox (Local)
                <% end %>
              <% end %>
              <div style="height: 1px; background: var(--border-subtle); margin: 0.75rem 0;"></div>
            <% end %>

            <!-- Business Navigation (for Admin & Employee, or Super Admin browsing business) -->
            <% if current_business.present? %>
              <div class="nav-label">Workspace</div>
              <%= link_to root_path, class: "nav-link #{'active' if current_page?(root_path)}" do %>
                <span class="nav-icon">📊</span> <%= employee? ? "My Work Overview" : "Dashboard" %>
              <% end %>

              <div class="nav-label">Daily Operations</div>
              <%= link_to bulk_attendances_path, class: "nav-link #{'active' if request.path == bulk_attendances_path}" do %>
                <span class="nav-icon">📝</span> Daily Attendance
              <% end %>
              <%= link_to calendar_attendances_path, class: "nav-link #{'active' if request.path == calendar_attendances_path}" do %>
                <span class="nav-icon">📅</span> Attendance Calendar
              <% end %>
              <%= link_to expenses_path, class: "nav-link #{'active' if request.path.include?('expenses')}" do %>
                <span class="nav-icon">☕</span> Daily Expenses (Tea/Food)
              <% end %>

              <% if admin? %>
                <%= link_to employees_path, class: "nav-link #{'active' if request.path.include?('employees')}" do %>
                  <span class="nav-icon">👷</span> Employees & Khata
                <% end %>
              <% end %>

              <div class="nav-label">Projects & Billing</div>
              <%= link_to work_projects_path, class: "nav-link #{'active' if request.path.include?('work_projects')}" do %>
                <span class="nav-icon">🏗️</span> Works / Projects
              <% end %>

              <% if admin? %>
                <%= link_to invoices_path, class: "nav-link #{'active' if request.path.include?('invoices')}" do %>
                  <span class="nav-icon">🧾</span> Invoices & Quotes
                <% end %>
                <%= link_to clients_path, class: "nav-link #{'active' if request.path.include?('clients')}" do %>
                  <span class="nav-icon">👥</span> Clients
                <% end %>

                <div class="nav-label">Financial Reports</div>
                <%= link_to pnl_report_path, class: "nav-link #{'active' if current_page?(pnl_report_path)}" do %>
                  <span class="nav-icon">📈</span> Monthly P&L
                <% end %>
                <%= link_to work_pnl_report_path, class: "nav-link #{'active' if current_page?(work_pnl_report_path)}" do %>
                  <span class="nav-icon">🎯</span> Work-wise P&L
                <% end %>

                <div class="nav-label">Settings</div>
                <%= link_to business_settings_path, class: "nav-link #{'active' if current_page?(business_settings_path)}" do %>
                  <span class="nav-icon">⚙️</span> Drive & Settings
                <% end %>
              <% end %>
            <% end %>
          </nav>

          <div class="sidebar-footer">
            <div class="user-badge">
              <div class="user-avatar" style="<%= 'background: linear-gradient(135deg, #f59e0b, #d97706);' if super_admin? %>">
                <%= current_user.full_name.first.upcase %>
              </div>
              <div class="user-details">
                <div class="user-name"><%= current_user.full_name %></div>
                <div class="user-role" style="<%= 'color: #fbbf24; font-weight: 700;' if super_admin? %>">
                  <%= current_user.role_title %>
                </div>
              </div>
            </div>
            <%= button_to "🚪 Sign out", session_path, method: :delete, class: "btn btn-secondary btn-sm", style: "width: 100%;", data: { turbo: false } %>
          </div>
        </aside>

        <!-- Main Wrapper -->
        <div class="main-wrapper">
          <header class="top-navbar no-print">
            <div class="page-title">
              <% if super_admin? && request.path.start_with?('/super_admin') %>
                <span style="color: #fbbf24;">👑 Super Admin Console</span>
              <% else %>
                <%= content_for(:page_title) || "Overview" %>
              <% end %>
            </div>

            <div class="top-actions">
              <% if super_admin? %>
                <%= link_to "👑 Super Admin", super_admin_root_path, class: "btn btn-warning btn-sm" %>
                <% if current_business.present? %>
                  <span style="font-size: 0.8rem; color: var(--text-muted); display: none; @media(min-width:600px){display:inline;}">
                    Viewing: <strong><%= current_business.name %></strong>
                  </span>
                <% end %>
              <% end %>

              <% if admin? && current_business.present? %>
                <%= link_to "+ Log Attendance", bulk_attendances_path, class: "btn btn-primary btn-sm" %>
                <%= link_to "+ Expense", new_expense_path, class: "btn btn-secondary btn-sm" %>
              <% elsif employee? %>
                <%= link_to "📝 Attendance", bulk_attendances_path, class: "btn btn-primary btn-sm" %>
                <%= link_to "+ Expense", new_expense_path, class: "btn btn-secondary btn-sm" %>
              <% end %>

              <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-secondary btn-sm", style: "display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.65rem; font-size: 0.8rem;", data: { turbo: false } %>
            </div>
          </header>

          <main class="content-container">
            <% if notice.present? %>
              <div class="alert alert-success">
                <span>✓</span> <%= notice %>
              </div>
            <% end %>
            <% if alert.present? %>
              <div class="alert alert-danger">
                <span>⚠️</span> <%= alert %>
              </div>
            <% end %>

            <%= yield %>
          </main>
        </div>

        <!-- Mobile Bottom Bar (Thumb navigation optimized for mobile) -->
        <nav class="mobile-bottom-nav no-print">
          <% if super_admin? %>
            <%= link_to super_admin_root_path, class: "mobile-nav-item #{'active' if current_page?(super_admin_root_path)}" do %>
              <span class="icon">👑</span>
              <span>Platform</span>
            <% end %>
            <%= link_to super_admin_businesses_path, class: "mobile-nav-item #{'active' if request.path.include?('super_admin/businesses')}" do %>
              <span class="icon">🏢</span>
              <span>Businesses</span>
            <% end %>
            <%= link_to root_path, class: "mobile-nav-item #{'active' if current_page?(root_path)}" do %>
              <span class="icon">📊</span>
              <span>App</span>
            <% end %>
            <%= link_to signout_path, class: "mobile-nav-item", data: { turbo: false } do %>
              <span class="icon">🚪</span>
              <span>Sign out</span>
            <% end %>
          <% elsif admin? %>
            <%= link_to root_path, class: "mobile-nav-item #{'active' if current_page?(root_path)}" do %>
              <span class="icon">📊</span>
              <span>Home</span>
            <% end %>
            <%= link_to bulk_attendances_path, class: "mobile-nav-item #{'active' if request.path.include?('attendances')}" do %>
              <span class="icon">📝</span>
              <span>Attendance</span>
            <% end %>
            <%= link_to new_expense_path, class: "mobile-nav-item #{'active' if request.path == new_expense_path}" do %>
              <span class="icon">☕</span>
              <span>+Expense</span>
            <% end %>
            <%= link_to work_projects_path, class: "mobile-nav-item #{'active' if request.path.include?('work_projects')}" do %>
              <span class="icon">🏗️</span>
              <span>Projects</span>
            <% end %>
            <%= link_to pnl_report_path, class: "mobile-nav-item #{'active' if request.path.include?('reports')}" do %>
              <span class="icon">📈</span>
              <span>P&L</span>
            <% end %>
          <% else %>
            <!-- Employee / Normal User Mobile Nav -->
            <%= link_to root_path, class: "mobile-nav-item #{'active' if current_page?(root_path)}" do %>
              <span class="icon">📊</span>
              <span>My Work</span>
            <% end %>
            <%= link_to bulk_attendances_path, class: "mobile-nav-item #{'active' if request.path.include?('attendances')}" do %>
              <span class="icon">📝</span>
              <span>Attendance</span>
            <% end %>
            <%= link_to new_expense_path, class: "mobile-nav-item #{'active' if request.path == new_expense_path}" do %>
              <span class="icon">☕</span>
              <span>+Tea/Food</span>
            <% end %>
            <%= link_to work_projects_path, class: "mobile-nav-item #{'active' if request.path.include?('work_projects')}" do %>
              <span class="icon">🏗️</span>
              <span>Projects</span>
            <% end %>
          <% end %>
        </nav>
      </div>
    <% else %>
      <!-- Unauthenticated View (Login / Register) -->
      <div class="auth-wrapper">
        <div class="auth-card">
          <% if notice.present? %>
            <div class="alert alert-success">
              <span>✓</span> <%= notice %>
            </div>
          <% end %>
          <% if alert.present? %>
            <div class="alert alert-danger">
              <span>⚠️</span> <%= alert %>
            </div>
          <% end %>

          <%= yield %>
        </div>
      </div>
    <% end %>
  </body>
</html>
