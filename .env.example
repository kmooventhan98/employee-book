# Rails Environment Variables
# Copy this file to .env on your server:
# cp .env.example .env

# Your Rails Master Key (found in config/master.key)
RAILS_MASTER_KEY=your_rails_master_key_here

# Secret Key Base (generate with: bin/rails secret)
SECRET_KEY_BASE=generate_with_bin_rails_secret

# Host for links in emails (e.g. https://mooventhan.in)
APP_HOST=mooventhan.in

# Outgoing Email / SMTP Settings (Zoho Mail, Gmail, SendGrid, Amazon SES, etc.)
SMTP_ADDRESS=smtp.zoho.in
SMTP_PORT=587
SMTP_DOMAIN=mooventhan.in
SMTP_USERNAME=mooventhan@zohomail.in
SMTP_PASSWORD=your_app_specific_password_here
SMTP_AUTH=plain
MAILER_DEFAULT_FROM=KarigarBook <mooventhan@zohomail.in>

# SSL Settings (set to false since Nginx handles SSL termination)
RAILS_FORCE_SSL=false
RAILS_ASSUME_SSL=false

# Embedded background jobs via Solid Queue inside Puma
SOLID_QUEUE_IN_PUMA=true
